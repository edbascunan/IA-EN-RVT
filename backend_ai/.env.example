# Archivo de configuración del bot
# Copiar este archivo como .env y completar con los valores reales

# Token del bot de Telegram (obtener de @BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Configuración opcional del bot
BOT_NAME=YouTube BIM Bot
LOG_LEVEL=INFO
MAX_VIDEOS_PER_DAY=50

# Rutas de archivos
PROCESSED_VIDEOS_DIR=processed_videos
SAVED_COMMANDS_DIR=saved_commands

# Configuración del sistema BIM
DEFAULT_CONCRETE_STRENGTH=H-25
DEFAULT_STEEL_STRENGTH=fy=420MPa
DEFAULT_LANGUAGE=es_AR

# Configuración de APIs (opcional - para uso futuro)
# OPENAI_API_KEY=your_openai_api_key_here
# YOUTUBE_API_KEY=your_youtube_api_key_here