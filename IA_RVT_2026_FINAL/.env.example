# IA-EN-RVT 2026 - Variables de Entorno
# =====================================

# Bot Principal Telegram
TELEGRAM_TOKEN=tu_token_aqui

# OpenAI API para NLP Real
OPENAI_API_KEY=tu_openai_key_aqui

# Configuración de Memoria y RAG
VECTOR_STORE_PATH=backend_ai/data/vector_store
MEMORY_DB_PATH=backend_ai/data/memory.db
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Configuración de Documentos
DOCUMENTS_PATH=backend_ai/data/documents
YOUTUBE_CACHE_PATH=backend_ai/data/youtube_cache

# Configuración de PYREVIT
PYREVIT_COMMAND_PATH=backend_ai/shared/command_out.json

# Configuración de Redis (opcional para memoria distribuida)
REDIS_URL=redis://localhost:6379/0

# Configuración de Logging
LOG_LEVEL=INFO
DEBUG=False

# Configuración de Seguridad
SECRET_KEY=tu_clave_secreta_aqui

# Configuración de Despliegue
RAILWAY_TOKEN=tu_railway_token_aqui
ENVIRONMENT=development